# Every value here is optional. With none of it set the app still runs: the full
# checklist and score work, the prose summary is skipped, and the counters fall
# back to a local file.

PORT=3000

# --- counters ---------------------------------------------------------------
# Two integers per day; never any file content. Set these to a hosted Turso
# database to survive Render free-tier restarts. Create one with:
#   turso db create pbiviz-checker
#   turso db show pbiviz-checker --url
#   turso db tokens create pbiviz-checker
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Only used when TURSO_DATABASE_URL is empty — where the local counters.db goes.
DATA_DIR=./data

# --- summary ----------------------------------------------------------------
# Both model variables take a COMMA-SEPARATED LIST, tried in order. Free tiers
# move: models get promoted to paid (404 "unavailable for free") and the ones
# that stay free return 429 under load, so a single slug is fragile.
# Use instruction-tuned models only — reasoning models emit their chain-of-thought
# as the answer, which the parser rejects and falls through on.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-nano-9b-v2:free,google/gemma-4-26b-a4b-it:free

# Independent fallback provider, used only after every OpenRouter model fails.
HF_API_KEY=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct,google/gemma-3-27b-it,meta-llama/Llama-3.1-8B-Instruct

# Sent to OpenRouter as the referer header. Set to your Render URL in production.
PUBLIC_URL=http://localhost:3000

# --- tunables ---------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800
BUNDLE_SIZE_LIMIT_BYTES=2097152
MIN_CERTIFIED_API_VERSION=5.3.0
OSV_TIMEOUT_MS=6000
LLM_TIMEOUT_MS=20000   # small free models can take 10s+
